# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved
DerivedData/
*.xcodeproj

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# iCloud hygiene (CONVENTIONS standing directive): keep regenerable dirs out
*.nosync/

# Sparkle code-signing: NEVER commit the private update-signing key (it lives in
# the login Keychain / a CI secret). sparkle_ed_priv is release.yml's temp filename.
*.private
sparkle_eddsa_private.key
sparkle_ed_priv
dsa_priv.pem

# Release output (DMGs, appcast, per-item fragments): regenerated, uploaded to
# GitHub Releases, never served from the repo.
dist/

# local secrets (never commit)
.env
.env.*

# Python bytecode cache (l10n scripts)
__pycache__/
*.pyc

# VS Code extension build artifacts (the shipped copy lives in Sources/Pathem/Resources)
Integrations/vscode-pathem/*.vsix
Integrations/vscode-pathem/node_modules/

# 1M-row scroll demo raw recordings (regenerable; commit the final GIF only)
docs/demo/*.mov

# Cloudflare Wrangler local cache/tmp (site Worker); regenerated on every dev run
.wrangler/
.claude/
