<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Pathem</string>
	<key>CFBundleDisplayName</key>
	<string>Pathem</string>
	<key>CFBundleIdentifier</key>
	<string>com.scarcrux.pathem</string>
	<key>CFBundleExecutable</key>
	<string>Pathem</string>
	<!-- Declare the app's language so a GUI-app process resolves a concrete locale
	     (en_US), which on-device FoundationModels requires; without this the bundle
	     resolves to an undetermined locale and the model returns "Unsupported language". -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Every language we actually ship a .lproj for. This has to list them all: macOS decides
	     what an app "supports" from this key, and it is what System Settings > Language & Region
	     offers when picking a per-app language. Declaring only "en" made Pathem look English-only
	     even though six translations ship (they live in the SwiftPM resource bundle, which the OS
	     never looks inside). Keep in sync with Sources/Pathem/Resources/*.lproj. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
		<string>de</string>
		<string>es</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleIconFile</key>
	<string>Pathem</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.0</string>
	<key>CFBundleVersion</key>
	<string>24</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Declare Pathem as a folder handler so Finder's "Open With ▸ Pathem" works and it can be
	     set as the default. Rank "Alternate" so installing Pathem never silently steals Finder's
	     default-folder role; the user opts in via Open With / Get Info. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>BitTorrent File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.bittorrent.torrent</string>
				<string>com.bittorrent.torrent</string>
			</array>
		</dict>
		<!-- PDFs and images open in Pathem's built-in viewer. Rank Alternate: the user can set
		     Pathem as the default via Finder's Get Info, but we don't grab it automatically. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<!-- Handle magnet: links so "open magnet URL" can hand off to Pathem's Torrents panel. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Magnet Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>magnet</string>
			</array>
		</dict>
	</array>
	<!-- A Services item so any app's Services menu can send a folder to Pathem. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in Pathem</string>
			</dict>
			<key>NSMessage</key>
			<string>openInPathem</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
			</array>
		</dict>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Scarcrux. Open source under the MIT License.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Per-folder access rationales shown in the system prompts the first time Pathem
	     reads each location. A file manager needs these; clear text raises trust and the
	     grant rate. (Full Disk Access is separate and can only be granted by hand.) -->
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Pathem browses and organizes your Downloads, and can offer to file new downloads into place.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Pathem browses and organizes the files on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Pathem browses and organizes the files in your Documents.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Pathem browses and manages files on connected drives, memory cards, and phones.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Pathem browses and manages files on mounted network shares.</string>
	<!-- Sparkle auto-update. The updater stays dormant until SUPublicEDKey is a
	     real EdDSA key (run Sparkle's generate_keys, paste the public key here).
	     SUFeedURL points at the appcast attached to GitHub Releases. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Scarcrux/Pathem/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_SPARKLE_PUBLIC_KEY</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
